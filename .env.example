# 로컬 워크스테이션에서만 사용한다. 실제 값이 들어간 .env는 커밋하지 않는다.

JJINBBANG_LAB_SSH_KEY=

CORE_HOST=
WORKER_1_HOST=
WORKER_2_HOST=

CORE_PRIVATE_IP=
WORKER_1_PRIVATE_IP=
WORKER_2_PRIVATE_IP=

CORE_PUBLIC_IP=
WORKER_1_PUBLIC_IP=
WORKER_2_PUBLIC_IP=

OCI_CLI_PROFILE=
OCI_COMPARTMENT_ID=

JJINBBANG_DNS_ZONE=
# Space-separated record names for DNS helper scripts.
# Platform default: auth argo n8n
# Add dev app record after API ingress is ready: auth argo n8n api-dev
# Production api record requires explicit cutover approval and ALLOW_API_CUTOVER=true.
JJINBBANG_DNS_RECORDS=
CLOUDFLARE_API_TOKEN=
# Optional. If empty, scripts/cloudflare-upsert-dns.sh looks it up by zone name.
CLOUDFLARE_ZONE_ID=

# Optional. If empty, scripts/bootstrap-n8n-owner.sh reuses Authentik bootstrap email.
N8N_OWNER_EMAIL=

# Optional fallback when the domain remains delegated to Route53.
# AWS_PROFILE is not a secret. ROUTE53_HOSTED_ZONE_ID is not a secret.
AWS_PROFILE=
ROUTE53_HOSTED_ZONE_ID=
